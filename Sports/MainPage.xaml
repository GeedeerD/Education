<ContentPage xmlns = "http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns: x = "http://schemas.microsoft.com/winfx/2009/xaml"
             x: Class = "Sports.MainPage" >

    <VerticalStackLayout Padding = "30" Spacing = "20" VerticalOptions = "Center" >

        <Label x: Name = "SportLabel"
               Text = "Вид спорта"
               FontSize = "32"
               HorizontalOptions = "Center"
               TextColor = "{DynamicResource PrimaryTextColor}" />

        <Label x: Name = "DescriptionLabel"
               Text = "Описание спорта"
               FontSize = "16"
               HorizontalOptions = "Center"
               TextColor = "{DynamicResource SecondaryTextColor}" />

        <Image x: Name = "SportImage"
               HeightRequest = "150"
               WidthRequest = "150"
               Aspect = "AspectFit"
               IsVisible = "False" />

        <Button Text = "Следующий вид спорта"
                Clicked = "OnChangeSportClicked"
                HorizontalOptions = "Center" />

        <Button Text = "Случайный спорт"
                Clicked = "OnRandomSportClicked"
                HorizontalOptions = "Center" />
    </ VerticalStackLayout >
</ ContentPage >