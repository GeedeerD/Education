<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Общие стили Fiwe. Экранам достаточно указать класс:
          Button.primary / .secondary / .ghost / .icon / .link / .nav
          TextBox (по умолчанию), TextBox.search
          TextBlock.h1 / .h2 / .h3 / .caption / .section
          Border.card / .notice(.warning/.danger/.success) / .header
          ListBox.list — список чатов, контактов
    -->

    <!-- ── Окно ─────────────────────────────────────────────── -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ── Типографика ──────────────────────────────────────── -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Заголовок группы настроек -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- ── Кнопки: общая форма ──────────────────────────────── -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Основная кнопка -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.primary PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- Второстепенная кнопка (контурная) -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.secondary PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Прозрачная кнопка -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.ghost PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.ghost.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.ghost.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Квадратная кнопка-иконка -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Неактивные прозрачные кнопки (заготовки «в разработке») — без серой заливки Fluent -->
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button:disabled PathIcon">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Кнопка-ссылка -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        Пункт боковой навигации: только иконка (подпись — во всплывающей подсказке).
        Свой шаблон, чтобы состояния «наведение» и «активный» не спорили с шаблоном Fluent:
        активный раздел — акцентная иконка и полоска у левого края.
    -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="Indicator"
                            Width="3" Height="22"
                            CornerRadius="0,2,2,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            IsVisible="False" />
                    <Border Name="Bg"
                            Width="40" Height="40"
                            CornerRadius="8"
                            Background="Transparent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.nav PathIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- Активный раздел объявлен последним — он важнее наведения -->
    <Style Selector="Button.nav.active /template/ Border#Indicator">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.nav.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ── Поля ввода ───────────────────────────────────────── -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="4,7,12,7" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ── Контейнеры ───────────────────────────────────────── -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.notice">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
    </Style>
    <Style Selector="Border.notice.warning">
        <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
    </Style>
    <Style Selector="Border.notice.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
    </Style>
    <Style Selector="Border.notice.success">
        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
    </Style>
    <Style Selector="Border.notice TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.notice.danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.notice.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- Шапка раздела -->
    <Style Selector="Border.header">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

    <!-- ── Списки (чаты, контакты) ──────────────────────────── -->
    <Style Selector="ListBox.list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
    </Style>

    <!-- Вкладки папок чатов: подчёркивание вместо «таблеток» -->
    <Style Selector="ToggleButton.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Margin="2,0" />
                    <Border Name="Underline" Height="2" CornerRadius="1" Background="Transparent" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.tab:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.tab:checked /template/ Border#Underline">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>

</Styles>
