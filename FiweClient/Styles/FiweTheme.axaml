<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Палитра Fiwe. Все экраны берут цвета только отсюда (через DynamicResource),
        поэтому светлая и тёмная темы переключаются на лету.
        Нейтральные серые без синего оттенка и один спокойный акцент — без «неоновых» плашек.
    -->

    <!-- Акцент бренда — одинаковый в обеих темах -->
    <Color x:Key="BrandColor">#1F7A68</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#1F7A68" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#248C77" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#19665A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D93F3F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C27C0E" />

    <!-- Акцентные цвета Fluent-контролов (ToggleSwitch, Slider, CheckBox, выделение текста) — под бренд -->
    <Color x:Key="SystemAccentColor">#1F7A68</Color>
    <Color x:Key="SystemAccentColorLight1">#248C77</Color>
    <Color x:Key="SystemAccentColorLight2">#3FA58F</Color>
    <Color x:Key="SystemAccentColorLight3">#6CC0AD</Color>
    <Color x:Key="SystemAccentColorDark1">#19665A</Color>
    <Color x:Key="SystemAccentColorDark2">#13544A</Color>
    <Color x:Key="SystemAccentColorDark3">#0E433B</Color>

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F6F4" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFEFEC" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8E8E4" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E3E3DF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E69" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E2F0EC" />
            <SolidColorBrush x:Key="AccentSoftTextBrush" Color="#1F7A68" />
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#ECECE8" />
            <SolidColorBrush x:Key="BubbleOtherBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BubbleOtherBorderBrush" Color="#E3E3DF" />
            <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#F6F6F4" />
            <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#EFEFEC" />
            <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FBF1DE" />
            <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FBE8E8" />
            <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E5F2EA" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#141414" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262626" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="DividerBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDEA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9A95" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1D3A33" />
            <SolidColorBrush x:Key="AccentSoftTextBrush" Color="#6CC0AD" />
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="BubbleOtherBrush" Color="#242424" />
            <SolidColorBrush x:Key="BubbleOtherBorderBrush" Color="#242424" />
            <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#141414" />
            <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#262626" />
            <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#3A2F17" />
            <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#3A1D1D" />
            <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#1A3326" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
