<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FiweClient.Converters"
             x:Class="FiweClient.App"
             RequestedThemeVariant="Default">
    <!-- Default = следует системной теме -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Конвертеры -->
        <conv:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
        <conv:BubbleColorConverter x:Key="BubbleColorConverter" />
        <conv:BubbleTextColorConverter x:Key="BubbleTextColorConverter" />

        <!-- Цвета бренда -->
        <Color x:Key="BrandColor">#5B6EF5</Color>
        <Color x:Key="BrandColorLight">#7B8EFF</Color>

        <!-- Цвета пузырей сообщений -->
        <Color x:Key="MyMessageBubble">#5B6EF5</Color>
        <Color x:Key="ContactMessageBubble">#3A3A4A</Color>
        <Color x:Key="ContactMessageBubbleLight">#E8E8F0</Color>
    </Application.Resources>
</Application>
