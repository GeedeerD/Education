<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FiweClient.Converters"
             x:Class="FiweClient.App"
             RequestedThemeVariant="Default">
	<!-- Default = следует системной теме; переключается в Настройках → Оформление -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://FiweClient.App/Styles/FiweStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Конвертеры -->
            <conv:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
            <conv:BubbleTextColorConverter x:Key="BubbleTextColorConverter" />
            <conv:EqualityConverter x:Key="EqualityConverter" />
            <conv:ChatMarkdownConverter x:Key="ChatMarkdownConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FiweClient.App/Styles/FiweTheme.axaml" />
                <ResourceInclude Source="avares://FiweClient.App/Styles/FiweIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
