<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Chats"
             x:Class="FiweClient.Views.ChatView"
             x:DataType="vm:ChatViewModel">

	<Grid RowDefinitions="Auto, *, Auto">

		<!-- ── Шапка чата ── -->
		<Border Grid.Row="0"
                Padding="16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
			<Panel>

				<!-- Обычный режим -->
				<Grid ColumnDefinitions="Auto, *, Auto"
					  IsVisible="{Binding !IsSelectionMode}">

					<!-- Иконка замка E2EE -->
					<Border Grid.Column="0"
							Background="{DynamicResource SystemAccentColor}"
							CornerRadius="20"
							Width="40" Height="40"
							Margin="0,0,12,0">
						<TextBlock Text="🔒"
								   FontSize="18"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center" />
					</Border>

					<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
						<TextBlock Text="{Binding ChatName}"
								   FontSize="16"
								   FontWeight="SemiBold" />
						<TextBlock Text="End-to-End Encrypted"
								   FontSize="11"
								   Foreground="Green"
								   IsVisible="False"
								   Opacity="0.8" />
					</StackPanel>

					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<ProgressBar IsIndeterminate="True"
									 IsVisible="{Binding IsBusy}"
									 Width="80" Height="3"
									 VerticalAlignment="Center" />
						<Button Content="Выбрать"
								Command="{Binding EnterSelectionModeCommand}" />
					</StackPanel>
				</Grid>

				<!-- Режим выделения -->
				<Grid ColumnDefinitions="Auto, *, Auto"
					  IsVisible="{Binding IsSelectionMode}">

					<Button Grid.Column="0"
							Content="Отмена"
							Command="{Binding CancelSelectionCommand}"
							VerticalAlignment="Center" />

					<TextBlock Grid.Column="1"
							   Text="{Binding SelectedCount, StringFormat='{}{0} выбрано'}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />

					<Button Grid.Column="2"
							Content="Удалить"
							Command="{Binding DeleteSelectedCommand}"
							IsEnabled="{Binding !IsBusy}"
							VerticalAlignment="Center" />
				</Grid>

			</Panel>
		</Border>

		<!-- ── Список сообщений ── -->
		<ScrollViewer Grid.Row="1" Padding="15,0,15,0">
			<ItemsControl ItemsSource="{Binding Messages}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:MessageBubbleViewModel">

						<!-- Контейнер пузыря: чекбокс + сам пузырь -->
						<Grid Margin="0,3" ColumnDefinitions="Auto, *">

							<!-- Чекбокс выделения (виден только в режиме выделения) -->
							<CheckBox Grid.Column="0"
                                      IsVisible="{Binding IsSelectionMode}"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />

							<Border Grid.Column="1"
                                    MaxWidth="480"
                                    Padding="12,8"
                                    CornerRadius="12"
                                    HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlignmentConverter}}"
                                    Background="{Binding IsMine, Converter={StaticResource BubbleColorConverter}}">

								<!-- ПКМ по сообщению → меню «Копировать» / «Удалить» -->
								<!-- Оба пункта обрабатываются в code-behind через Click,
                                     т.к. ContextMenu рендерится в отдельном попапе и
                                     обычный Command-биндинг через $parent к нему "не дотягивается". -->
								<Border.ContextMenu>
									<ContextMenu>
										<MenuItem Header="📋 Копировать"
                                                  Click="OnCopyMessageClick" />
										<MenuItem Header="🗑 Удалить"
                                                  Click="OnDeleteMessageClick" />
									</ContextMenu>
								</Border.ContextMenu>

								<StackPanel Spacing="4">
									<TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="{Binding IsMine, Converter={StaticResource BubbleTextColorConverter}}" />
									<TextBlock Text="{Binding TimeLabel}"
                                               FontSize="10"
                                               Opacity="0.65"
                                               HorizontalAlignment="Right" />
								</StackPanel>
							</Border>
						</Grid>

					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- ── Ошибка ── -->
		<Border Grid.Row="1"
                VerticalAlignment="Bottom"
                Margin="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="12" />
		</Border>

		<!-- ── Поле ввода сообщения ── -->
		<Border Grid.Row="2"
                Padding="12,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                IsVisible="{Binding !IsSelectionMode}">
			<Grid ColumnDefinitions="*, Auto">

				<TextBox Grid.Column="0"
                         Text="{Binding MessageInput}"
                         Watermark="Введите сообщение..."
                         AcceptsReturn="False"
                         Height="44"
                         VerticalContentAlignment="Center">
					<!-- Отправка по Enter -->
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Return" Command="{Binding SendMessageCommand}" />
					</TextBox.KeyBindings>
				</TextBox>

				<Button Grid.Column="1"
                        Content="Отправить"
                        Command="{Binding SendMessageCommand}"
                        Height="44"
                        Padding="18,0"
                        IsEnabled="{Binding !IsBusy}" />

			</Grid>
		</Border>

	</Grid>

</UserControl>