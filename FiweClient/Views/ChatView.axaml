<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Chats"
             xmlns:mdc="clr-namespace:FiweClient.Markdown"
             xmlns:ctl="clr-namespace:FiweClient.Controls"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:mdctl="clr-namespace:Markdown.Avalonia.Controls;assembly=Markdown.Avalonia"
             x:Class="FiweClient.Views.ChatView"
             x:DataType="vm:ChatViewModel">

	<UserControl.Resources>
		<!-- Скрепка (Material Design Icons, «paperclip»): ровная векторная иконка вместо эмодзи 📎,
		     которое в разных шрифтах рисуется наклонённым и со смещением. -->
		<StreamGeometry x:Key="PaperclipIcon">M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z</StreamGeometry>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Стилизация контекстного меню сообщений: скруглённые углы,
             отступы и выделение опасного действия («Удалить») красным. -->
		<Style Selector="ContextMenu">
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="6" />
			<Setter Property="MinWidth" Value="190" />
		</Style>

		<Style Selector="MenuItem">
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,8" />
			<Setter Property="Margin" Value="0,1" />
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="MenuItem.danger">
			<Setter Property="Foreground" Value="#E5484D" />
		</Style>

		<Style Selector="Separator">
			<Setter Property="Margin" Value="6,4" />
			<Setter Property="Opacity" Value="0.5" />
		</Style>

		<!-- Пузыри сообщений: чужие — нейтральные слева, свои — акцентные справа.
		     Меньший радиус на нижнем углу со стороны отправителя — «хвостик». -->
		<Style Selector="Border.bubble">
			<Setter Property="MaxWidth" Value="520" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="CornerRadius" Value="12,12,12,4" />
			<Setter Property="Background" Value="{DynamicResource BubbleOtherBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BubbleOtherBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Border.bubble.mine">
			<Setter Property="CornerRadius" Value="12,12,4,12" />
			<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>

		<!-- Круглые полупрозрачные кнопки поверх просмотрщика изображений -->
		<Style Selector="Button.viewer">
			<Setter Property="Background" Value="#66000000" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="22" />
			<Setter Property="Width" Value="44" />
			<Setter Property="Height" Value="44" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Padding" Value="0" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto, *, Auto">

		<!-- ── Шапка чата ── -->
		<Border Grid.Row="0" Classes="header" Padding="8,0,16,0">
			<Panel>

				<!-- Обычный режим -->
				<Grid ColumnDefinitions="Auto, Auto, *, Auto"
					  IsVisible="{Binding !IsSelectionMode}">

					<Button Grid.Column="0"
							Classes="icon"
							Command="{Binding CloseCommand}"
							ToolTip.Tip="К списку чатов"
							Margin="0,0,4,0">
						<PathIcon Data="{StaticResource IconBack}" />
					</Button>

					<ctl:AvatarView Grid.Column="1"
									DisplayName="{Binding ChatName}"
									Size="40"
									Margin="0,0,12,0" />

					<StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
						<TextBlock Text="{Binding ChatName}"
								   FontSize="16"
								   FontWeight="SemiBold"
								   TextTrimming="CharacterEllipsis" />
						<StackPanel Orientation="Horizontal" Spacing="4">
							<PathIcon Data="{StaticResource IconLock}"
									  Width="11" Height="11"
									  Foreground="{DynamicResource SuccessBrush}" />
							<TextBlock Text="Сквозное шифрование"
									   FontSize="11"
									   Foreground="{DynamicResource TextSecondaryBrush}" />
						</StackPanel>
					</StackPanel>

					<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<ProgressBar IsIndeterminate="True"
									 IsVisible="{Binding IsBusy}"
									 Width="60" MinWidth="60"
									 Height="3" MinHeight="3"
									 VerticalAlignment="Center" />
						<Button Classes="icon"
								Command="{Binding EnterSelectionModeCommand}"
								ToolTip.Tip="Выбрать сообщения">
							<PathIcon Data="{StaticResource IconCheck}" />
						</Button>
					</StackPanel>
				</Grid>

				<!-- Режим выделения -->
				<Grid ColumnDefinitions="Auto, *, Auto"
					  IsVisible="{Binding IsSelectionMode}">

					<Button Grid.Column="0"
							Classes="ghost"
							Content="Отмена"
							Command="{Binding CancelSelectionCommand}"
							Margin="8,0,0,0"
							VerticalAlignment="Center" />

					<TextBlock Grid.Column="1"
							   Text="{Binding SelectedCount, StringFormat='{}Выбрано: {0}'}"
							   FontSize="15"
							   FontWeight="SemiBold"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />

					<Button Grid.Column="2"
							Classes="ghost danger"
							Content="Удалить"
							Command="{Binding DeleteSelectedCommand}"
							IsEnabled="{Binding !IsBusy}"
							VerticalAlignment="Center" />
				</Grid>

			</Panel>
		</Border>

		<!-- ── Список сообщений ── -->
		<!-- Горизонтальная прокрутка выключена: иначе длинные сообщения не переносятся и уезжают за край на узком экране -->
		<ScrollViewer x:Name="MessagesScroll" Grid.Row="1"
		              HorizontalScrollBarVisibility="Disabled">
			<ItemsControl ItemsSource="{Binding Messages}" Margin="16,12">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:MessageBubbleViewModel">

						<!-- Контейнер пузыря: чекбокс + сам пузырь -->
						<Grid Margin="0,3" ColumnDefinitions="Auto, *">

							<!-- Чекбокс выделения (виден только в режиме выделения) -->
							<CheckBox Grid.Column="0"
                                      IsVisible="{Binding IsSelectionMode}"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />

							<!-- Цвет и «хвостик» пузыря — стили Border.bubble / Border.bubble.mine выше -->
							<Border Grid.Column="1"
                                    Classes="bubble"
                                    Classes.mine="{Binding IsMine}"
                                    HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlignmentConverter}}">

								<!-- ПКМ по сообщению → меню «Ответить» / «Копировать» / «Удалить» -->
								<!-- Пункты обрабатываются в code-behind через Click,
                                     т.к. ContextMenu рендерится в отдельном попапе и
                                     обычный Command-биндинг через $parent к нему "не дотягивается". -->
								<Border.ContextMenu>
									<ContextMenu>
										<MenuItem Click="OnReplyMessageClick">
											<MenuItem.Icon>
												<TextBlock Text="↩️" FontSize="14" />
											</MenuItem.Icon>
											<MenuItem.Header>
												<TextBlock Text="Ответить" />
											</MenuItem.Header>
										</MenuItem>

										<MenuItem Click="OnCopyMessageClick">
											<MenuItem.Icon>
												<TextBlock Text="📋" FontSize="14" />
											</MenuItem.Icon>
											<MenuItem.Header>
												<TextBlock Text="Копировать" />
											</MenuItem.Header>
										</MenuItem>

										<Separator />

										<MenuItem Classes="danger" Click="OnDeleteMessageClick">
											<MenuItem.Icon>
												<TextBlock Text="🗑" FontSize="14" />
											</MenuItem.Icon>
											<MenuItem.Header>
												<TextBlock Text="Удалить" />
											</MenuItem.Header>
										</MenuItem>
									</ContextMenu>
								</Border.ContextMenu>

								<StackPanel Spacing="4">

									<!-- Одно изображение — в натуральных пропорциях; клик открывает просмотр -->
									<Panel IsVisible="{Binding IsSingleImage}">
										<Panel DataContext="{Binding FirstImage}"
										       x:DataType="vm:MessageImageViewModel"
										       MaxWidth="320"
										       Background="Transparent"
										       Cursor="Hand"
										       Tapped="OnBubbleImageTapped">
											<Image Source="{Binding Bitmap}"
											       IsVisible="{Binding HasBitmap}"
											       MaxWidth="320" MaxHeight="320"
											       Stretch="Uniform" />
											<TextBlock Text="Загрузка изображения…"
											           IsVisible="{Binding IsLoading}"
											           FontSize="12"
											           Opacity="0.7" />
										</Panel>
									</Panel>

									<!-- Несколько изображений — сетка квадратных превью -->
									<ItemsControl IsVisible="{Binding IsAlbum}"
									              ItemsSource="{Binding Images}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<UniformGrid Columns="2" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:MessageImageViewModel">
												<Border Width="156" Height="156" Margin="2"
												        CornerRadius="8" ClipToBounds="True"
												        Background="#22000000"
												        Cursor="Hand"
												        Tapped="OnBubbleImageTapped">
													<Panel>
														<Image Source="{Binding Bitmap}"
														       IsVisible="{Binding HasBitmap}"
														       Stretch="UniformToFill" />
														<TextBlock Text="…"
														           IsVisible="{Binding IsLoading}"
														           HorizontalAlignment="Center"
														           VerticalAlignment="Center" />
													</Panel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<!-- Текст (у сообщения с изображениями — подпись) в Markdown.
									     Цвет текста наследуется от Foreground, стили — свои, компактные под пузырь. -->
									<mdc:ChatMarkdownViewer Markdown="{Binding Text, Converter={StaticResource ChatMarkdownConverter}}"
									                         IsVisible="{Binding ShowMarkdown}"
									                         TextElement.Foreground="{Binding IsMine, Converter={StaticResource BubbleTextColorConverter}}">
										<mdc:ChatMarkdownViewer.MarkdownStyle>
											<Styles>
												<Style Selector="ctxt|CTextBlock">
													<Setter Property="FontSize" Value="14" />
													<Setter Property="Margin" Value="0" />
												</Style>
												<Style Selector="ctxt|CTextBlock.Paragraph">
													<Setter Property="Margin" Value="0,2" />
												</Style>
												<Style Selector="ctxt|CTextBlock.Heading1">
													<Setter Property="FontSize" Value="20" />
													<Setter Property="FontWeight" Value="Bold" />
													<Setter Property="Margin" Value="0,4,0,2" />
												</Style>
												<Style Selector="ctxt|CTextBlock.Heading2">
													<Setter Property="FontSize" Value="18" />
													<Setter Property="FontWeight" Value="Bold" />
													<Setter Property="Margin" Value="0,4,0,2" />
												</Style>
												<Style Selector="ctxt|CTextBlock.Heading3">
													<Setter Property="FontSize" Value="16" />
													<Setter Property="FontWeight" Value="SemiBold" />
													<Setter Property="Margin" Value="0,4,0,2" />
												</Style>
												<Style Selector="ctxt|CTextBlock.Heading4, ctxt|CTextBlock.Heading5, ctxt|CTextBlock.Heading6">
													<Setter Property="FontSize" Value="14" />
													<Setter Property="FontWeight" Value="SemiBold" />
													<Setter Property="Margin" Value="0,4,0,2" />
												</Style>
												<Style Selector="ctxt|CCode">
													<Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,Roboto Mono,monospace" />
													<Setter Property="Background" Value="#33000000" />
												</Style>
												<Style Selector="ctxt|CHyperlink">
													<Setter Property="IsUnderline" Value="True" />
												</Style>
												<Style Selector="Border.CodeBlock">
													<Setter Property="Background" Value="#33000000" />
													<Setter Property="CornerRadius" Value="6" />
													<Setter Property="Padding" Value="8,6" />
													<Setter Property="Margin" Value="0,4" />
												</Style>
												<Style Selector="TextBlock.CodeBlock">
													<Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,Roboto Mono,monospace" />
													<Setter Property="FontSize" Value="13" />
												</Style>
												<Style Selector="Border.Blockquote">
													<Setter Property="BorderBrush" Value="#99808080" />
													<Setter Property="BorderThickness" Value="3,0,0,0" />
													<Setter Property="Padding" Value="8,0,0,0" />
													<Setter Property="Margin" Value="0,4" />
												</Style>
												<Style Selector="Border.Blockquote ctxt|CTextBlock">
													<Setter Property="Opacity" Value="0.85" />
												</Style>
												<Style Selector="Grid.List">
													<Setter Property="Margin" Value="0,2" />
												</Style>
												<Style Selector="ctxt|CTextBlock.ListMarker, TextBlock.ListMarker">
													<Setter Property="Margin" Value="4,0,6,0" />
												</Style>
												<Style Selector="mdctl|Rule">
													<Setter Property="SingleLineWidth" Value="1" />
													<Setter Property="BoldLineWidth" Value="2" />
													<Setter Property="LineMargin" Value="2" />
													<Setter Property="Margin" Value="0,6" />
													<Setter Property="Opacity" Value="0.5" />
												</Style>
												<Style Selector="Grid.Table">
													<Setter Property="Margin" Value="0,4" />
												</Style>
												<Style Selector="Grid.Table > Border">
													<Setter Property="BorderBrush" Value="#66808080" />
													<Setter Property="BorderThickness" Value="0.5" />
													<Setter Property="Padding" Value="6,2" />
												</Style>
												<Style Selector="Border.TableHeader ctxt|CTextBlock">
													<Setter Property="FontWeight" Value="SemiBold" />
												</Style>
											</Styles>
										</mdc:ChatMarkdownViewer.MarkdownStyle>
									</mdc:ChatMarkdownViewer>

									<!-- Сообщение, отправленное «без форматирования», — показываем как есть -->
									<TextBlock Text="{Binding Text}"
									           IsVisible="{Binding ShowPlainText}"
									           TextWrapping="Wrap"
									           FontSize="14"
									           Foreground="{Binding IsMine, Converter={StaticResource BubbleTextColorConverter}}" />

									<TextBlock Text="{Binding TimeLabel}"
                                               FontSize="10"
                                               Opacity="0.7"
                                               Foreground="{Binding IsMine, Converter={StaticResource BubbleTextColorConverter}}"
                                               HorizontalAlignment="Right" />
								</StackPanel>
							</Border>
						</Grid>

					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- ── Ошибка ── -->
		<Border Grid.Row="1"
                Classes="notice danger"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<TextBlock Text="{Binding ErrorMessage}" FontSize="12" />
		</Border>

		<!-- ── Поле ввода сообщения ── -->
		<Border Grid.Row="2"
                Padding="12,8,12,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}"
                IsVisible="{Binding !IsSelectionMode}">
			<StackPanel>

				<!-- Панель предпросмотра ответа (видна, только если выбрали «Ответить») -->
				<Border IsVisible="{Binding HasReply}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,8">
					<Grid ColumnDefinitions="Auto, *, Auto">
						<PathIcon Grid.Column="0"
                                  Data="{StaticResource IconReply}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource AccentBrush}"
                                  VerticalAlignment="Center"
                                  Margin="2,0,10,0" />
						<StackPanel Grid.Column="1" VerticalAlignment="Center">
							<TextBlock Text="Ответ на сообщение"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
							<TextBlock Text="{Binding ReplyingTo.PreviewText}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
						</StackPanel>
						<Button Grid.Column="2"
                                Classes="icon"
                                Width="32" Height="32"
                                Command="{Binding CancelReplyCommand}"
                                ToolTip.Tip="Отменить ответ"
                                VerticalAlignment="Center">
							<PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
						</Button>
					</Grid>
				</Border>

				<!-- Выбранные, но ещё не отправленные изображения. Отправляются кнопкой «Отправить»,
				     набранный текст уходит подписью к ним. -->
				<StackPanel IsVisible="{Binding HasPendingAttachments}"
				            Spacing="4"
				            Margin="0,0,0,8">
					<ScrollViewer HorizontalScrollBarVisibility="Auto"
					              VerticalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding PendingAttachments}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" Spacing="8" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:PendingAttachmentViewModel">
									<Panel Width="72" Height="72">
										<Border CornerRadius="8" ClipToBounds="True">
											<Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
										</Border>
										<Button Content="✕"
										        ToolTip.Tip="Убрать"
										        Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).RemoveAttachmentCommand}"
										        CommandParameter="{Binding}"
										        Classes="viewer"
										        Width="22" Height="22" CornerRadius="11"
										        FontSize="11"
										        Margin="2"
										        HorizontalAlignment="Right"
										        VerticalAlignment="Top" />
									</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
					<TextBlock Text="{Binding PendingAttachments.Count, StringFormat='{}Выбрано изображений: {0}. Текст сообщения станет подписью.'}"
					           FontSize="11"
					           Opacity="0.7" />
				</StackPanel>

				<!-- Панель форматирования Markdown. Кнопки не забирают фокус,
				     чтобы выделение в поле ввода не сбрасывалось. -->
				<!-- На узком экране панель прокручивается по горизонтали, а не обрезается -->
				<ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="44,0,0,6">
				<StackPanel Orientation="Horizontal" Spacing="2">
					<StackPanel.Styles>
						<Style Selector="Button.format, ToggleButton.format">
							<Setter Property="Focusable" Value="False" />
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
							<Setter Property="CornerRadius" Value="8" />
							<Setter Property="MinWidth" Value="32" />
							<Setter Property="Height" Value="28" />
							<Setter Property="Padding" Value="6,0" />
							<Setter Property="FontSize" Value="13" />
							<Setter Property="HorizontalContentAlignment" Value="Center" />
							<Setter Property="VerticalContentAlignment" Value="Center" />
						</Style>
						<!-- Markdown выключен — переключатель приглушён и перечёркнут -->
						<Style Selector="ToggleButton.format:unchecked">
							<Setter Property="Opacity" Value="0.55" />
						</Style>
						<Style Selector="ToggleButton.format:unchecked TextBlock">
							<Setter Property="TextDecorations" Value="Strikethrough" />
						</Style>
					</StackPanel.Styles>

					<!-- Переключатель Markdown. Выбор запоминается (тот же пункт есть в настройках).
					     Ctrl+Shift+Enter — разово отправить сообщение без форматирования. -->
					<ToggleButton Classes="format"
					              IsChecked="{Binding IsMarkdownEnabled}"
					              ToolTip.Tip="Форматирование Markdown. Отправить одно сообщение без форматирования — Ctrl+Shift+Enter">
						<TextBlock Text="M↓" FontWeight="SemiBold" />
					</ToggleButton>

					<StackPanel Orientation="Horizontal" Spacing="4"
					            IsVisible="{Binding IsMarkdownEnabled}">
						<Border Width="1" Height="18" Margin="2,0"
						        Background="{DynamicResource DividerBrush}"
						        Opacity="0.4" />
						<Button Classes="format" Tag="bold" Click="OnFormatClick" ToolTip.Tip="Жирный (Ctrl+B)">
							<TextBlock Text="B" FontWeight="Bold" />
						</Button>
						<Button Classes="format" Tag="italic" Click="OnFormatClick" ToolTip.Tip="Курсив (Ctrl+I)">
							<TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia,serif" />
						</Button>
						<Button Classes="format" Tag="strike" Click="OnFormatClick" ToolTip.Tip="Зачёркнутый (Ctrl+Shift+X)">
							<TextBlock Text="S" TextDecorations="Strikethrough" />
						</Button>
						<Button Classes="format" Tag="code" Click="OnFormatClick" ToolTip.Tip="Код (Ctrl+E)">
							<TextBlock Text="&lt;/&gt;" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
						</Button>
						<Button Classes="format" Tag="link" Click="OnFormatClick" ToolTip.Tip="Ссылка (Ctrl+K)">
							<TextBlock Text="🔗" />
						</Button>
						<Button Classes="format" Tag="quote" Click="OnFormatClick" ToolTip.Tip="Цитата">
							<TextBlock Text="❝" />
						</Button>
						<Button Classes="format" Tag="list" Click="OnFormatClick" ToolTip.Tip="Список">
							<TextBlock Text="•≡" />
						</Button>
					</StackPanel>
				</StackPanel>
				</ScrollViewer>

				<Grid ColumnDefinitions="Auto, *, Auto">

					<Button Grid.Column="0"
                            Classes="icon"
                            Click="OnAttachImageClick"
                            ToolTip.Tip="Прикрепить изображения"
                            Height="44"
                            Width="40"
                            Margin="0,0,4,0"
                            VerticalAlignment="Bottom"
                            IsEnabled="{Binding !IsBusy}">
						<PathIcon Data="{StaticResource IconPaperclip}" Width="22" Height="22" />
					</Button>

					<!-- Enter — отправка, Shift+Enter — новая строка (на Android Enter всегда переносит строку,
					     отправка — кнопкой). Клавиши обрабатываются в code-behind: OnMessageInputKeyDown. -->
					<TextBox x:Name="MessageInputBox"
                             Grid.Column="1"
                             Text="{Binding MessageInput}"
                             Watermark="Сообщение…"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             CornerRadius="22"
                             Padding="16,11"
                             MinHeight="44"
                             MaxHeight="160"
                             VerticalContentAlignment="Center" />

					<Button Grid.Column="2"
                            Classes="primary"
                            Command="{Binding SendMessageCommand}"
                            ToolTip.Tip="Отправить (Enter)"
                            Width="44" Height="44"
                            Padding="0"
                            CornerRadius="22"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            IsEnabled="{Binding !IsBusy}">
						<PathIcon Data="{StaticResource IconSend}" Width="18" Height="18" Margin="3,0,0,0" />
					</Button>

				</Grid>
			</StackPanel>
		</Border>

		<!-- ── Просмотр изображения на весь экран ── -->
		<!-- Клик по затемнённому фону или Esc — закрыть, ←/→ — листать картинки сообщения. -->
		<Panel x:Name="ImageViewerOverlay"
		       Grid.Row="0" Grid.RowSpan="3"
		       ZIndex="100"
		       IsVisible="{Binding IsImageViewerOpen}"
		       Background="#E6000000"
		       Focusable="True"
		       Tapped="OnImageViewerBackgroundTapped">
			<Panel.KeyBindings>
				<KeyBinding Gesture="Escape" Command="{Binding CloseImageViewerCommand}" />
				<KeyBinding Gesture="Left" Command="{Binding ShowPreviousImageCommand}" />
				<KeyBinding Gesture="Right" Command="{Binding ShowNextImageCommand}" />
			</Panel.KeyBindings>

			<Image Source="{Binding ViewedImage.Bitmap}"
			       Stretch="Uniform"
			       StretchDirection="DownOnly"
			       Margin="24,64,24,24" />

			<TextBlock Text="{Binding ViewerPositionLabel}"
			           IsVisible="{Binding CanViewerNavigate}"
			           Foreground="White"
			           FontSize="14"
			           Margin="0,22,0,0"
			           HorizontalAlignment="Center"
			           VerticalAlignment="Top" />

			<Button Classes="viewer"
			        Content="✕"
			        ToolTip.Tip="Закрыть"
			        Command="{Binding CloseImageViewerCommand}"
			        Margin="12"
			        HorizontalAlignment="Right"
			        VerticalAlignment="Top" />

			<Button Classes="viewer"
			        Content="‹"
			        IsVisible="{Binding CanViewerNavigate}"
			        Command="{Binding ShowPreviousImageCommand}"
			        Margin="12"
			        HorizontalAlignment="Left"
			        VerticalAlignment="Center" />

			<Button Classes="viewer"
			        Content="›"
			        IsVisible="{Binding CanViewerNavigate}"
			        Command="{Binding ShowNextImageCommand}"
			        Margin="12"
			        HorizontalAlignment="Right"
			        VerticalAlignment="Center" />
		</Panel>

	</Grid>

</UserControl>
