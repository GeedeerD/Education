<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Chats"
             x:Class="FiweClient.Views.ChatView"
             x:DataType="vm:ChatViewModel">

	<UserControl.Resources>
		<!-- Скрепка (Material Design Icons, «paperclip»): ровная векторная иконка вместо эмодзи 📎,
		     которое в разных шрифтах рисуется наклонённым и со смещением. -->
		<StreamGeometry x:Key="PaperclipIcon">M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z</StreamGeometry>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Стилизация контекстного меню сообщений: скруглённые углы,
             отступы и выделение опасного действия («Удалить») красным. -->
		<Style Selector="ContextMenu">
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="6" />
			<Setter Property="MinWidth" Value="190" />
		</Style>

		<Style Selector="MenuItem">
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10,8" />
			<Setter Property="Margin" Value="0,1" />
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style Selector="MenuItem.danger">
			<Setter Property="Foreground" Value="#E5484D" />
		</Style>

		<Style Selector="Separator">
			<Setter Property="Margin" Value="6,4" />
			<Setter Property="Opacity" Value="0.5" />
		</Style>

		<!-- Круглые полупрозрачные кнопки поверх просмотрщика изображений -->
		<Style Selector="Button.viewer">
			<Setter Property="Background" Value="#66000000" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="22" />
			<Setter Property="Width" Value="44" />
			<Setter Property="Height" Value="44" />
			<Setter Property="FontSize" Value="20" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Padding" Value="0" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto, *, Auto">

		<!-- ── Шапка чата ── -->
		<Border Grid.Row="0"
                Padding="16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
			<Panel>

				<!-- Обычный режим -->
				<Grid ColumnDefinitions="Auto, *, Auto"
					  IsVisible="{Binding !IsSelectionMode}">

					<!-- Иконка замка E2EE -->
					<Border Grid.Column="0"
							Background="{DynamicResource SystemAccentColor}"
							CornerRadius="20"
							Width="40" Height="40"
							Margin="0,0,12,0">
						<TextBlock Text="🔒"
								   FontSize="18"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center" />
					</Border>

					<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
						<TextBlock Text="{Binding ChatName}"
								   FontSize="16"
								   FontWeight="SemiBold" />
						<TextBlock Text="End-to-End Encrypted"
								   FontSize="11"
								   Foreground="Green"
								   IsVisible="False"
								   Opacity="0.8" />
					</StackPanel>

					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<ProgressBar IsIndeterminate="True"
									 IsVisible="{Binding IsBusy}"
									 Width="80" Height="3"
									 VerticalAlignment="Center" />
						<Button Content="Выбрать"
								Command="{Binding EnterSelectionModeCommand}" />
					</StackPanel>
				</Grid>

				<!-- Режим выделения -->
				<Grid ColumnDefinitions="Auto, *, Auto"
					  IsVisible="{Binding IsSelectionMode}">

					<Button Grid.Column="0"
							Content="Отмена"
							Command="{Binding CancelSelectionCommand}"
							VerticalAlignment="Center" />

					<TextBlock Grid.Column="1"
							   Text="{Binding SelectedCount, StringFormat='{}{0} выбрано'}"
							   FontSize="16"
							   FontWeight="SemiBold"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />

					<Button Grid.Column="2"
							Content="Удалить"
							Command="{Binding DeleteSelectedCommand}"
							IsEnabled="{Binding !IsBusy}"
							VerticalAlignment="Center" />
				</Grid>

			</Panel>
		</Border>

		<!-- ── Список сообщений ── -->
		<ScrollViewer Grid.Row="1" Padding="15,0,15,0">
			<ItemsControl ItemsSource="{Binding Messages}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:MessageBubbleViewModel">

						<!-- Контейнер пузыря: чекбокс + сам пузырь -->
						<Grid Margin="0,3" ColumnDefinitions="Auto, *">

							<!-- Чекбокс выделения (виден только в режиме выделения) -->
							<CheckBox Grid.Column="0"
                                      IsVisible="{Binding IsSelectionMode}"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />

							<Border Grid.Column="1"
                                    MaxWidth="480"
                                    Padding="12,8"
                                    CornerRadius="12"
                                    HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlignmentConverter}}"
                                    Background="{Binding IsMine, Converter={StaticResource BubbleColorConverter}}">

								<!-- ПКМ по сообщению → меню «Ответить» / «Копировать» / «Удалить» -->
								<!-- Пункты обрабатываются в code-behind через Click,
                                     т.к. ContextMenu рендерится в отдельном попапе и
                                     обычный Command-биндинг через $parent к нему "не дотягивается". -->
								<Border.ContextMenu>
									<ContextMenu>
										<MenuItem Click="OnReplyMessageClick">
											<MenuItem.Icon>
												<TextBlock Text="↩️" FontSize="14" />
											</MenuItem.Icon>
											<MenuItem.Header>
												<TextBlock Text="Ответить" />
											</MenuItem.Header>
										</MenuItem>

										<MenuItem Click="OnCopyMessageClick">
											<MenuItem.Icon>
												<TextBlock Text="📋" FontSize="14" />
											</MenuItem.Icon>
											<MenuItem.Header>
												<TextBlock Text="Копировать" />
											</MenuItem.Header>
										</MenuItem>

										<Separator />

										<MenuItem Classes="danger" Click="OnDeleteMessageClick">
											<MenuItem.Icon>
												<TextBlock Text="🗑" FontSize="14" />
											</MenuItem.Icon>
											<MenuItem.Header>
												<TextBlock Text="Удалить" />
											</MenuItem.Header>
										</MenuItem>
									</ContextMenu>
								</Border.ContextMenu>

								<StackPanel Spacing="4">

									<!-- Одно изображение — в натуральных пропорциях; клик открывает просмотр -->
									<Panel IsVisible="{Binding IsSingleImage}">
										<Panel DataContext="{Binding FirstImage}"
										       x:DataType="vm:MessageImageViewModel"
										       MaxWidth="320"
										       Background="Transparent"
										       Cursor="Hand"
										       Tapped="OnBubbleImageTapped">
											<Image Source="{Binding Bitmap}"
											       IsVisible="{Binding HasBitmap}"
											       MaxWidth="320" MaxHeight="320"
											       Stretch="Uniform" />
											<TextBlock Text="Загрузка изображения…"
											           IsVisible="{Binding IsLoading}"
											           FontSize="12"
											           Opacity="0.7" />
										</Panel>
									</Panel>

									<!-- Несколько изображений — сетка квадратных превью -->
									<ItemsControl IsVisible="{Binding IsAlbum}"
									              ItemsSource="{Binding Images}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<UniformGrid Columns="2" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:MessageImageViewModel">
												<Border Width="156" Height="156" Margin="2"
												        CornerRadius="8" ClipToBounds="True"
												        Background="#22000000"
												        Cursor="Hand"
												        Tapped="OnBubbleImageTapped">
													<Panel>
														<Image Source="{Binding Bitmap}"
														       IsVisible="{Binding HasBitmap}"
														       Stretch="UniformToFill" />
														<TextBlock Text="…"
														           IsVisible="{Binding IsLoading}"
														           HorizontalAlignment="Center"
														           VerticalAlignment="Center" />
													</Panel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<!-- Текст (у сообщения с изображениями — подпись) -->
									<TextBlock Text="{Binding Text}"
                                               IsVisible="{Binding HasText}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="{Binding IsMine, Converter={StaticResource BubbleTextColorConverter}}" />

									<TextBlock Text="{Binding TimeLabel}"
                                               FontSize="10"
                                               Opacity="0.65"
                                               HorizontalAlignment="Right" />
								</StackPanel>
							</Border>
						</Grid>

					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- ── Ошибка ── -->
		<Border Grid.Row="1"
                VerticalAlignment="Bottom"
                Margin="12"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="12" />
		</Border>

		<!-- ── Поле ввода сообщения ── -->
		<Border Grid.Row="2"
                Padding="12,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                IsVisible="{Binding !IsSelectionMode}">
			<StackPanel>

				<!-- Панель предпросмотра ответа (видна, только если выбрали «Ответить») -->
				<Border IsVisible="{Binding HasReply}"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,0,0,8">
					<Grid ColumnDefinitions="Auto, *, Auto">
						<TextBlock Grid.Column="0"
                                   Text="↩️"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
						<StackPanel Grid.Column="1" VerticalAlignment="Center">
							<TextBlock Text="Ответ на сообщение"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Opacity="0.7" />
							<TextBlock Text="{Binding ReplyingTo.PreviewText}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
						</StackPanel>
						<Button Grid.Column="2"
                                Content="✕"
                                Command="{Binding CancelReplyCommand}"
                                Padding="8,2"
                                VerticalAlignment="Center" />
					</Grid>
				</Border>

				<!-- Выбранные, но ещё не отправленные изображения. Отправляются кнопкой «Отправить»,
				     набранный текст уходит подписью к ним. -->
				<StackPanel IsVisible="{Binding HasPendingAttachments}"
				            Spacing="4"
				            Margin="0,0,0,8">
					<ScrollViewer HorizontalScrollBarVisibility="Auto"
					              VerticalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding PendingAttachments}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" Spacing="8" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:PendingAttachmentViewModel">
									<Panel Width="72" Height="72">
										<Border CornerRadius="8" ClipToBounds="True">
											<Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
										</Border>
										<Button Content="✕"
										        ToolTip.Tip="Убрать"
										        Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).RemoveAttachmentCommand}"
										        CommandParameter="{Binding}"
										        Classes="viewer"
										        Width="22" Height="22" CornerRadius="11"
										        FontSize="11"
										        Margin="2"
										        HorizontalAlignment="Right"
										        VerticalAlignment="Top" />
									</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
					<TextBlock Text="{Binding PendingAttachments.Count, StringFormat='{}Выбрано изображений: {0}. Текст сообщения станет подписью.'}"
					           FontSize="11"
					           Opacity="0.7" />
				</StackPanel>

				<Grid ColumnDefinitions="Auto, *, Auto">

					<Button Grid.Column="0"
                            Click="OnAttachImageClick"
                            ToolTip.Tip="Прикрепить изображения"
                            Height="44"
                            Width="44"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding !IsBusy}">
						<PathIcon Data="{StaticResource PaperclipIcon}" Width="20" Height="20" />
					</Button>

					<TextBox Grid.Column="1"
                             Text="{Binding MessageInput}"
                             Watermark="Введите сообщение..."
                             AcceptsReturn="False"
                             Height="44"
                             VerticalContentAlignment="Center">
						<!-- Отправка по Enter -->
						<TextBox.KeyBindings>
							<KeyBinding Gesture="Return" Command="{Binding SendMessageCommand}" />
						</TextBox.KeyBindings>
					</TextBox>

					<Button Grid.Column="2"
                            Content="Отправить"
                            Command="{Binding SendMessageCommand}"
                            Height="44"
                            Padding="18,0"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding !IsBusy}" />

				</Grid>
			</StackPanel>
		</Border>

		<!-- ── Просмотр изображения на весь экран ── -->
		<!-- Клик по затемнённому фону или Esc — закрыть, ←/→ — листать картинки сообщения. -->
		<Panel x:Name="ImageViewerOverlay"
		       Grid.Row="0" Grid.RowSpan="3"
		       ZIndex="100"
		       IsVisible="{Binding IsImageViewerOpen}"
		       Background="#E6000000"
		       Focusable="True"
		       Tapped="OnImageViewerBackgroundTapped">
			<Panel.KeyBindings>
				<KeyBinding Gesture="Escape" Command="{Binding CloseImageViewerCommand}" />
				<KeyBinding Gesture="Left" Command="{Binding ShowPreviousImageCommand}" />
				<KeyBinding Gesture="Right" Command="{Binding ShowNextImageCommand}" />
			</Panel.KeyBindings>

			<Image Source="{Binding ViewedImage.Bitmap}"
			       Stretch="Uniform"
			       StretchDirection="DownOnly"
			       Margin="24,64,24,24" />

			<TextBlock Text="{Binding ViewerPositionLabel}"
			           IsVisible="{Binding CanViewerNavigate}"
			           Foreground="White"
			           FontSize="14"
			           Margin="0,22,0,0"
			           HorizontalAlignment="Center"
			           VerticalAlignment="Top" />

			<Button Classes="viewer"
			        Content="✕"
			        ToolTip.Tip="Закрыть"
			        Command="{Binding CloseImageViewerCommand}"
			        Margin="12"
			        HorizontalAlignment="Right"
			        VerticalAlignment="Top" />

			<Button Classes="viewer"
			        Content="‹"
			        IsVisible="{Binding CanViewerNavigate}"
			        Command="{Binding ShowPreviousImageCommand}"
			        Margin="12"
			        HorizontalAlignment="Left"
			        VerticalAlignment="Center" />

			<Button Classes="viewer"
			        Content="›"
			        IsVisible="{Binding CanViewerNavigate}"
			        Command="{Binding ShowNextImageCommand}"
			        Margin="12"
			        HorizontalAlignment="Right"
			        VerticalAlignment="Center" />
		</Panel>

	</Grid>

</UserControl>
