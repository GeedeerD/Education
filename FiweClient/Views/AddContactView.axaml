<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Contacts"
             x:Class="FiweClient.Views.AddContactView"
             x:DataType="vm:AddContactViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">

        <!-- Шапка -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,20">
            <Button Grid.Column="0"
                    Content="← Назад"
                    Command="{Binding GoBackCommand}"
                    Margin="0,0,12,0" />
            <TextBlock Grid.Column="1"
                       Text="Найти пользователя"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Поиск и результаты -->
        <StackPanel Grid.Row="1" Spacing="16">

            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         Watermark="Публичное имя пользователя"
                         Height="44">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Return" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Content="Найти"
                        Command="{Binding SearchCommand}"
                        Height="44"
                        Padding="18,0"
                        IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         Height="3" />

            <!-- Статус -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="Green"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Результаты поиска -->
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserSearchResultViewModel">
                        <Border Padding="12,10"
                                Margin="0,4"
                                CornerRadius="8"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding UserName}"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding UserId}"
                                               FontSize="11"
                                               Opacity="0.4" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Добавить"
                                        Command="{Binding AddCommand}"
                                        Padding="14,8" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>

    </Grid>

</UserControl>
