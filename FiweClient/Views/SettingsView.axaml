<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels"
             xmlns:ctl="clr-namespace:FiweClient.Controls"
             x:Class="FiweClient.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <!-- Переключатель темы — три «плитки» -->
        <Style Selector="RadioButton.tile">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Tile"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="12,10">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="RadioButton.tile:pointerover /template/ Border#Tile">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="RadioButton.tile:checked /template/ Border#Tile">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" Classes="header">
            <TextBlock Classes="h2" Text="Настройки" VerticalAlignment="Center" />
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20,20,20,32" Spacing="16" MaxWidth="560">

                <!-- Статус последнего действия -->
                <Border Classes="notice success"
                        IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding SuccessMessage}" />
                </Border>
                <Border Classes="notice danger"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" />
                </Border>

                <!-- ── Профиль ── -->
                <Border Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="overline" Text="ПРОФИЛЬ" />

                        <Grid ColumnDefinitions="Auto, *">
                            <ctl:AvatarView DisplayName="{Binding Username}" Size="64" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="{Binding Username}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="caption" Text="Имя аккаунта (логин)" />
                                <!-- Задел под issue #42 «User Avatars»: загрузка фото профиля -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary"
                                            MinHeight="32"
                                            Padding="12,0"
                                            IsEnabled="False"
                                            ToolTip.Tip="Загрузка фото профиля появится в следующих версиях"
                                            ToolTip.ShowOnDisabled="True">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconCamera}" Width="14" Height="14" />
                                            <TextBlock Text="Изменить фото" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Border Classes="badge">
                                        <TextBlock Text="СКОРО" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="h3" Text="Публичное имя" />
                            <TextBlock Classes="caption"
                                       Text="По публичному имени вас смогут найти другие пользователи. Оно не должно совпадать с именем аккаунта." />
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding PublicName}"
                                         Watermark="Например: john_doe" />
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Content="Сохранить"
                                        Command="{Binding SavePublicNameCommand}"
                                        Margin="8,0,0,0"
                                        IsEnabled="{Binding !IsBusy}" />
                            </Grid>
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsBusy}"
                                         Height="2" MinHeight="2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Оформление ── -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="overline" Text="ОФОРМЛЕНИЕ" />
                        <TextBlock Classes="h3" Text="Тема" />
                        <Grid ColumnDefinitions="*, 8, *, 8, *">
                            <RadioButton Classes="tile" GroupName="Theme" IsChecked="{Binding IsSystemTheme}">
                                <StackPanel Spacing="6">
                                    <Border Width="40" Height="26" CornerRadius="6" HorizontalAlignment="Center"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                                        <Grid ColumnDefinitions="*, *">
                                            <Border Background="#F4F5FA" />
                                            <Border Grid.Column="1" Background="#1A1B24" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Как в системе" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="2" Classes="tile" GroupName="Theme" IsChecked="{Binding IsLightTheme}">
                                <StackPanel Spacing="6">
                                    <Border Width="40" Height="26" CornerRadius="6" HorizontalAlignment="Center"
                                            Background="#F4F5FA" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" />
                                    <TextBlock Text="Светлая" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="4" Classes="tile" GroupName="Theme" IsChecked="{Binding IsDarkTheme}">
                                <StackPanel Spacing="6">
                                    <Border Width="40" Height="26" CornerRadius="6" HorizontalAlignment="Center"
                                            Background="#1A1B24" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" />
                                    <TextBlock Text="Тёмная" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Сообщения ── -->
                <Border Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="overline" Text="СООБЩЕНИЯ" />

                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4" Margin="0,0,12,0">
                                <TextBlock Classes="h3" Text="Форматирование Markdown" />
                                <TextBlock Classes="caption"
                                           Text="**Жирный**, *курсив*, `код`, ссылки, списки и цитаты. То же переключает кнопка M↓ над полем ввода. Одно сообщение без форматирования — Ctrl+Shift+Enter." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding MarkdownEnabled}"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <StackPanel Spacing="8">
                            <TextBlock Classes="h3" Text="Часовой пояс" />
                            <TextBlock Classes="caption"
                                       Text="Смещение относительно UTC для времени сообщений." />
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <Slider Grid.Column="0"
                                        Value="{Binding UtcOffsetHours}"
                                        Minimum="-12"
                                        Maximum="14"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding OffsetLabel}"
                                           Width="76"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="2"
                                        Classes="secondary"
                                        Content="Сохранить"
                                        Command="{Binding SaveTimezoneCommand}"
                                        Margin="12,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Безопасность ── -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="overline" Text="БЕЗОПАСНОСТЬ" />
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Width="40" Height="40"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top">
                                <PathIcon Data="{StaticResource IconKey}"
                                          Width="20" Height="20"
                                          Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="h3" Text="Перенос ключей шифрования" />
                                <TextBlock Classes="caption"
                                           Text="Переносит ваши E2EE-ключи на новое устройство: покажите QR-код новому устройству во время входа в аккаунт." />
                            </StackPanel>
                        </Grid>
                        <Button Classes="secondary"
                                Content="Показать QR для переноса ключей"
                                Command="{Binding OpenQrGeneratorCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
