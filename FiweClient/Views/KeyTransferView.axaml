<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Auth"
             x:Class="FiweClient.Views.KeyTransferView"
             x:DataType="vm:KeyTransferViewModel">

    <ScrollViewer>
    <Grid RowDefinitions="*, Auto, *">
        <StackPanel Grid.Row="1"
                    MaxWidth="420"
                    Margin="20,32"
                    Spacing="18"
                    HorizontalAlignment="Stretch">

            <!-- Иконка -->
            <Border Width="64" Height="64"
                    CornerRadius="20"
                    Background="{DynamicResource AccentSoftBrush}"
                    HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconKey}"
                          Width="30" Height="30"
                          Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <!-- Заголовок -->
            <TextBlock Classes="h2"
                       Text="Перенос ключей шифрования"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />

            <!-- Описание -->
            <Border Classes="notice"
                    CornerRadius="8"
                    Padding="16,12">
                <TextBlock TextWrapping="Wrap"
                           FontSize="13"
                           Opacity="0.85"
                           LineHeight="20">
                    Ваш аккаунт уже зарегистрирован на другом устройстве. Чтобы читать историю переписки, перенесите ключи шифрования.&#x0a;&#x0a;Откройте приложение на старом устройстве → Настройки → «Перенос ключей» и отсканируйте QR-код или скопируйте код переноса.
                </TextBlock>
            </Border>

            <Border Height="1"
                    Background="{DynamicResource DividerBrush}"
                    Opacity="0.2" />

            <!-- Поле ввода кода -->
            <StackPanel Spacing="8">
                <TextBlock Text="Код переноса"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding TransferCode}"
                         Watermark="Вставьте код с другого устройства"
                         Height="52"
                         AcceptsReturn="False" />
            </StackPanel>

            <!-- Кнопка сканирования (только на Android, где есть камера) -->
            <Button Classes="secondary" Content="Сканировать QR-код"
                    Command="{Binding ScanQrCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Height="44"
                    IsVisible="{Binding IsScannerAvailable}"
                    IsEnabled="{Binding !IsBusy}" />

            <!-- Ошибка -->
            <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Classes="notice danger"
                    CornerRadius="6"
                    Padding="12,8">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Прогресс -->
            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         Height="3" />

            <!-- Кнопка импорта -->
            <Button Classes="primary" Content="Импортировать ключи"
                    Command="{Binding ImportKeyCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Height="44"
                    IsEnabled="{Binding !IsBusy}" />

            <!-- Разделитель -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Border Width="100" Height="1"
                        Background="{DynamicResource DividerBrush}"
                        Opacity="0.2"
                        VerticalAlignment="Center" />
                <TextBlock Text="или" Opacity="0.5" FontSize="12" />
                <Border Width="100" Height="1"
                        Background="{DynamicResource DividerBrush}"
                        Opacity="0.2"
                        VerticalAlignment="Center" />
            </StackPanel>

            <!-- Новые ключи (деструктивное действие) -->
            <StackPanel Spacing="8">
                <Button Classes="ghost danger" Content="Создать новые ключи (история переписки недоступна)"
                        Command="{Binding GenerateNewKeyCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="44"
                        Foreground="{DynamicResource DangerBrush}"
                        IsEnabled="{Binding !IsBusy}" />
                <TextBlock Text="Старые зашифрованные сообщения нельзя будет расшифровать."
                           FontSize="11"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </Grid>
    </ScrollViewer>

</UserControl>
