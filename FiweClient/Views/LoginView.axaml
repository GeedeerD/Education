<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Auth"
             x:Class="FiweClient.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <ScrollViewer>
        <Grid RowDefinitions="*, Auto, *" MinHeight="560">
            <StackPanel Grid.Row="1"
                        MaxWidth="400"
                        Margin="20,32"
                        Spacing="24"
                        HorizontalAlignment="Stretch">

                <!-- Логотип -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="fiwe"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconLock}"
                                  Width="12" Height="12"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Classes="caption" Text="Мессенджер со сквозным шифрованием" />
                    </StackPanel>
                </StackPanel>

                <!-- Форма -->
                <Border Classes="card" Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="h3" Text="Вход в аккаунт" />

                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="Имя пользователя" />
                            <TextBox x:Name="UsernameBox"
                                     Text="{Binding Username}"
                                     Watermark="Логин" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="Пароль" />
                            <TextBox Text="{Binding Password}"
                                     Watermark="Пароль"
                                     PasswordChar="●"
                                     RevealPassword="{Binding #ShowPassword.IsChecked}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <CheckBox x:Name="ShowPassword" Content="Показать пароль" FontSize="12" />
                        </StackPanel>

                        <Border Classes="notice danger"
                                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ErrorMessage}" />
                        </Border>

                        <Button Classes="primary"
                                Content="Войти"
                                Command="{Binding LoginCommand}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding !IsBusy}" />

                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}"
                                     Height="3" MinHeight="3" />
                    </StackPanel>
                </Border>

                <!-- Переход к регистрации -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Classes="caption" Text="Нет аккаунта?" VerticalAlignment="Center" />
                    <Button Classes="link"
                            Content="Зарегистрироваться"
                            Command="{Binding GoToRegisterCommand}" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
