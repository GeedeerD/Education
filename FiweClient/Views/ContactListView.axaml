<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Contacts"
             x:Class="FiweClient.Views.ContactListView"
             x:DataType="vm:ContactListViewModel">

    <Grid RowDefinitions="Auto, *">

        <!-- Шапка -->
        <Border Grid.Row="0" Classes="header">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Classes="h2" Text="Контакты" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="primary"
                        MinHeight="38"
                        Padding="14,0"
                        Command="{Binding OpenAddContactCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconAccountPlus}" Width="16" Height="16" />
                        <TextBlock Text="Добавить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Пустое состояние (сервер пока не отдаёт список контактов) -->
        <StackPanel Grid.Row="1"
                    MaxWidth="320"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
            <TextBlock Classes="h3" Text="Контактов пока нет" HorizontalAlignment="Center" />
            <TextBlock Classes="caption"
                       Text="Найдите собеседника по его публичному имени — после добавления с ним появится чат."
                       TextAlignment="Center" />
            <Button Classes="secondary"
                    Content="Найти пользователя"
                    HorizontalAlignment="Center"
                    Command="{Binding OpenAddContactCommand}" />
        </StackPanel>

    </Grid>

</UserControl>
