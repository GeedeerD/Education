<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Auth"
             x:Class="FiweClient.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <ScrollViewer>
        <Grid RowDefinitions="*, Auto, *" MinHeight="600">
            <StackPanel Grid.Row="1"
                        MaxWidth="400"
                        Margin="20,32"
                        Spacing="24"
                        HorizontalAlignment="Stretch">

                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Classes="h1" Text="Регистрация" HorizontalAlignment="Center" />
                    <TextBlock Classes="caption"
                               Text="Создайте аккаунт, чтобы начать общение"
                               TextAlignment="Center" />
                </StackPanel>

                <Border Classes="card" Padding="24">
                    <StackPanel Spacing="14">

                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="Имя пользователя" />
                            <TextBox Text="{Binding Username}" Watermark="Логин для входа" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="Пароль" />
                            <TextBox Text="{Binding Password}"
                                     Watermark="Пароль"
                                     PasswordChar="●"
                                     RevealPassword="{Binding #ShowPassword.IsChecked}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="Повторите пароль" />
                            <TextBox Text="{Binding ConfirmPassword}"
                                     Watermark="Ещё раз"
                                     PasswordChar="●"
                                     RevealPassword="{Binding #ShowPassword.IsChecked}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding RegisterCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <CheckBox x:Name="ShowPassword" Content="Показать пароль" FontSize="12" />
                        </StackPanel>

                        <Border Classes="notice danger"
                                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ErrorMessage}" />
                        </Border>

                        <Button Classes="primary"
                                Content="Создать аккаунт"
                                Command="{Binding RegisterCommand}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding !IsBusy}" />

                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}"
                                     Height="3" MinHeight="3" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Classes="caption" Text="Уже есть аккаунт?" VerticalAlignment="Center" />
                    <Button Classes="link"
                            Content="Войти"
                            Command="{Binding GoToLoginCommand}" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
