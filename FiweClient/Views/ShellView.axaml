<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels"
             xmlns:chats="clr-namespace:FiweClient.ViewModels.Chats"
             xmlns:contacts="clr-namespace:FiweClient.ViewModels.Contacts"
             xmlns:settings="clr-namespace:FiweClient.ViewModels.Settings"
             xmlns:views="clr-namespace:FiweClient.Views"
             xmlns:ctl="clr-namespace:FiweClient.Controls"
             x:Class="FiweClient.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="chats:ChatListViewModel">
            <views:ChatListView />
        </DataTemplate>
        <DataTemplate DataType="chats:ChatViewModel">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="contacts:ContactListViewModel">
            <views:ContactListView />
        </DataTemplate>
        <DataTemplate DataType="contacts:AddContactViewModel">
            <views:AddContactView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="settings:QrGeneratorViewModel">
            <views:QrGeneratorView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="76, *">

        <!-- ══════════════ Боковая панель ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerBrush}">

            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Логотип -->
                <Border Grid.Row="0"
                        Width="44" Height="44"
                        Margin="0,16,0,20"
                        CornerRadius="14"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="F"
                               FontSize="22"
                               FontWeight="Black"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Разделы -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="8,0">
                    <Button Classes="nav"
                            Classes.active="{Binding IsChatsActive}"
                            Command="{Binding OpenChatsCommand}"
                            ToolTip.Tip="Чаты">
                        <StackPanel Spacing="4">
                            <PathIcon Data="{StaticResource IconChat}" />
                            <TextBlock Text="Чаты" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsContactsActive}"
                            Command="{Binding OpenContactsCommand}"
                            ToolTip.Tip="Контакты">
                        <StackPanel Spacing="4">
                            <PathIcon Data="{StaticResource IconContacts}" />
                            <TextBlock Text="Контакты" />
                        </StackPanel>
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Настройки">
                        <StackPanel Spacing="4">
                            <PathIcon Data="{StaticResource IconSettings}" />
                            <TextBlock Text="Настройки" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Профиль и выход -->
                <StackPanel Grid.Row="2" Spacing="10" Margin="8,0,8,14">
                    <Button Classes="ghost"
                            Padding="0"
                            HorizontalAlignment="Center"
                            CornerRadius="22"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{Binding Username}">
                        <ctl:AvatarView DisplayName="{Binding Username}" Size="40" />
                    </Button>

                    <Button Classes="icon"
                            HorizontalAlignment="Center"
                            Command="{Binding LogoutCommand}"
                            ToolTip.Tip="Выйти из аккаунта">
                        <PathIcon Data="{StaticResource IconLogout}" />
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ══════════════ Контент раздела ══════════════ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentContent}" />

    </Grid>

</UserControl>
