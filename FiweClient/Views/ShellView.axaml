<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels"
             xmlns:chats="clr-namespace:FiweClient.ViewModels.Chats"
             xmlns:contacts="clr-namespace:FiweClient.ViewModels.Contacts"
             xmlns:settings="clr-namespace:FiweClient.ViewModels.Settings"
             xmlns:views="clr-namespace:FiweClient.Views"
             xmlns:ctl="clr-namespace:FiweClient.Controls"
             x:Class="FiweClient.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="chats:ChatListViewModel">
            <views:ChatListView />
        </DataTemplate>
        <DataTemplate DataType="chats:ChatViewModel">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="contacts:ContactListViewModel">
            <views:ContactListView />
        </DataTemplate>
        <DataTemplate DataType="contacts:AddContactViewModel">
            <views:AddContactView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="settings:QrGeneratorViewModel">
            <views:QrGeneratorView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="60, *">

        <!-- ══════════════ Боковая панель ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerBrush}">

            <Grid RowDefinitions="Auto, *, Auto">

                <!-- Логотип: просто строчная «f» цветом бренда -->
                <TextBlock Grid.Row="0"
                           Text="f"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,14" />

                <!-- Разделы: только иконки, названия — во всплывающих подсказках -->
                <StackPanel Grid.Row="1" Spacing="2">
                    <Button Classes="nav"
                            Classes.active="{Binding IsChatsActive}"
                            Command="{Binding OpenChatsCommand}"
                            ToolTip.Tip="Чаты"
                            ToolTip.Placement="Right">
                        <PathIcon Data="{StaticResource IconChatOutline}" />
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsContactsActive}"
                            Command="{Binding OpenContactsCommand}"
                            ToolTip.Tip="Контакты"
                            ToolTip.Placement="Right">
                        <PathIcon Data="{StaticResource IconContactsOutline}" />
                    </Button>
                </StackPanel>

                <!-- Низ: настройки, профиль, выход -->
                <StackPanel Grid.Row="2" Spacing="2" Margin="0,0,0,12">
                    <Button Classes="nav"
                            Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Настройки"
                            ToolTip.Placement="Right">
                        <PathIcon Data="{StaticResource IconSettingsOutline}" />
                    </Button>

                    <Button Classes="nav"
                            Command="{Binding LogoutCommand}"
                            ToolTip.Tip="Выйти из аккаунта"
                            ToolTip.Placement="Right">
                        <PathIcon Data="{StaticResource IconLogout}" Width="20" Height="20" />
                    </Button>

                    <ctl:AvatarView DisplayName="{Binding Username}"
                                    Size="32"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding Username}"
                                    ToolTip.Placement="Right" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- ══════════════ Контент раздела ══════════════ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentContent}" />

    </Grid>

</UserControl>
