<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiweClient.ViewModels.Chats"
             xmlns:views="clr-namespace:FiweClient.Views"
             xmlns:ctl="clr-namespace:FiweClient.Controls"
             x:Class="FiweClient.Views.ChatListView"
             x:DataType="vm:ChatListViewModel">

    <!-- Широкое окно: список слева, открытый чат справа.
         Узкое (телефон): либо список, либо чат — переключается в code-behind (UpdateLayoutMode). -->
    <Grid x:Name="RootGrid" ColumnDefinitions="320, *">

        <!-- ══════════════ Список чатов ══════════════ -->
        <Border x:Name="ListPane"
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerBrush}">

            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">

                <!-- Заголовок -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20,12,12,8">
                    <TextBlock Classes="h2" Text="Чаты" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="icon"
                            Command="{Binding FindContactCommand}"
                            ToolTip.Tip="Найти собеседника">
                        <PathIcon Data="{StaticResource IconAccountPlus}" />
                    </Button>
                </Grid>

                <!-- Поиск по чатам -->
                <TextBox Grid.Row="1"
                         Classes="search"
                         Margin="16,0,16,10"
                         Text="{Binding SearchQuery}"
                         Watermark="Поиск чатов">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource IconSearch}"
                                  Width="16" Height="16"
                                  Margin="12,0,6,0"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- Папки чатов (#41): вкладки, «+» — новая папка, правый клик по вкладке — переименовать/удалить -->
                <StackPanel Grid.Row="2" Margin="20,0,12,6" Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Bottom">
                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatFolderViewModel">
                                        <Button Classes="tab"
                                                Classes.selected="{Binding IsSelected}"
                                                Content="{Binding Name}"
                                                Command="{Binding $parent[UserControl].((vm:ChatListViewModel)DataContext).SelectFolderCommand}"
                                                CommandParameter="{Binding}"
                                                ContextRequested="OnFolderContextRequested" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Classes="icon"
                                Width="28" Height="28"
                                Margin="8,0,0,0"
                                Command="{Binding StartCreateFolderCommand}"
                                ToolTip.Tip="Новая папка">
                            <PathIcon Data="{StaticResource IconPlus}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- Название новой папки / переименование: Enter — сохранить, Esc — отмена -->
                    <Grid ColumnDefinitions="*, Auto, Auto"
                          Margin="-4,0,4,0"
                          IsVisible="{Binding IsFolderEditorOpen}">
                        <TextBox x:Name="FolderNameBox"
                                 Text="{Binding FolderEditorText}"
                                 Watermark="{Binding FolderEditorWatermark}"
                                 MaxLength="32"
                                 MinHeight="34"
                                 Padding="10,6">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SaveFolderEditorCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelFolderEditorCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Classes="icon"
                                Width="32" Height="32"
                                Margin="4,0,0,0"
                                Command="{Binding SaveFolderEditorCommand}"
                                ToolTip.Tip="Сохранить">
                            <PathIcon Data="{StaticResource IconCheck}" Width="16" Height="16" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="icon"
                                Width="32" Height="32"
                                Command="{Binding CancelFolderEditorCommand}"
                                ToolTip.Tip="Отмена">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Загрузка / ошибка -->
                <StackPanel Grid.Row="3">
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}"
                                 Height="2" MinHeight="2"
                                 Margin="16,0" />
                    <Border Classes="notice danger"
                            Margin="16,4"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ErrorMessage}" />
                    </Border>
                    <Border Classes="notice success"
                            Margin="16,4"
                            IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding InfoMessage}" />
                    </Border>
                </StackPanel>

                <!-- Пусто -->
                <StackPanel Grid.Row="4"
                            IsVisible="{Binding ShowEmptyState}"
                            Margin="24,40"
                            Spacing="12"
                            HorizontalAlignment="Center">
                    <TextBlock Classes="caption"
                               Text="{Binding EmptyStateText}"
                               TextAlignment="Center"
                               MaxWidth="220" />
                    <Button Classes="secondary"
                            Content="Найти собеседника"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding ShowFindContactButton}"
                            Command="{Binding FindContactCommand}" />
                </StackPanel>

                <!-- Список -->
                <ListBox Grid.Row="4"
                         Classes="list"
                         IsVisible="{Binding !ShowEmptyState}"
                         ItemsSource="{Binding Chats}"
                         SelectedItem="{Binding SelectedChat}"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatPreviewViewModel">
                            <!-- Правый клик (на телефоне — долгое нажатие): меню «В папку» -->
                            <Grid ColumnDefinitions="Auto, *, Auto"
                                  Background="Transparent"
                                  ContextRequested="OnChatContextRequested">
                                <ctl:AvatarView DisplayName="{Binding Name}" Source="{Binding Avatar}" Size="46" Margin="0,0,12,0" />

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastMessage}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding LastMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding TimeLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,4,0,0"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <!-- ══════════════ Открытый чат ══════════════ -->
        <Panel x:Name="ChatPane" Grid.Column="1" Background="{DynamicResource ChatBackgroundBrush}">

            <ContentControl Content="{Binding ActiveChat}"
                            IsVisible="{Binding HasActiveChat}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:ChatViewModel">
                        <views:ChatView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Заглушка, пока чат не выбран -->
            <StackPanel IsVisible="{Binding !HasActiveChat}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <TextBlock Text="Выберите чат слева"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Opacity="0.8">
                    <PathIcon Data="{StaticResource IconLock}"
                              Width="11" Height="11"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Classes="caption" Text="Сообщения защищены сквозным шифрованием" />
                </StackPanel>
            </StackPanel>
        </Panel>

        <!-- ══════════════ Подтверждение «Удалить контакт?» ══════════════ -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2"
               ZIndex="50"
               Background="#66000000"
               IsVisible="{Binding IsDeleteConfirmOpen}">
            <Border Classes="card"
                    MaxWidth="400"
                    Margin="20"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Classes="h3" Text="Удалить контакт?" />
                    <TextBlock Text="{Binding DeleteConfirmText}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsDeletingContact}"
                                 Height="2" MinHeight="2" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="secondary"
                                Content="Отмена"
                                Command="{Binding CancelDeleteContactCommand}"
                                IsEnabled="{Binding !IsDeletingContact}" />
                        <Button Classes="primary danger"
                                Content="Удалить"
                                Command="{Binding ConfirmDeleteContactCommand}"
                                IsEnabled="{Binding !IsDeletingContact}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

    </Grid>

</UserControl>
