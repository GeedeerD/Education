<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileFirst.MainPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Shapes">

    <VerticalStackLayout Padding="20" Spacing="30" Background="DimGray">

        <!-- Заголовок -->
        <Label Text="Выберите фигуру:" 
               FontSize="20"
               HorizontalOptions="Center"/>

        <!-- Выпадающий список -->
        <Picker x:Name="ShapePicker"
                Title="Фигура"
                SelectedIndexChanged="OnShapeSelected">
            <Picker.Items>
                <x:String>Треугольник</x:String>
                <x:String>Круг</x:String>
                <x:String>Квадрат</x:String>
                <x:String>Полигон</x:String>
            </Picker.Items>
        </Picker>

        <!-- Картинка выбранной фигуры -->
        <Image x:Name="ShapeImage"
               WidthRequest="504"
               Aspect="AspectFit"
               VerticalOptions="Start"/>
    </VerticalStackLayout>
</ContentPage>