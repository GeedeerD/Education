<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="MobileFirst.ImagePickerPopup">

    <Frame BackgroundColor="White" Padding="10">
        <CollectionView x:Name="ImageList"
                        SelectionMode="Single"
                        SelectionChanged="OnImageSelected">
            <CollectionView.ItemsSource>
                <x:Array Type="{x:Type ImageSource}">
                    <ImageSource>image1.png</ImageSource>
                    <ImageSource>image2.png</ImageSource>
                    <ImageSource>image3.png</ImageSource>
                </x:Array>
            </CollectionView.ItemsSource>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" HeightRequest="80" WidthRequest="80"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Frame>
</toolkit:Popup>